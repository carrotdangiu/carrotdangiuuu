<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>❤️ BÍ MẬT QUỐC GIA ❤️</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden;overflow-x:hidden}
body{
  background:#000;
  font-family:Arial,Helvetica,sans-serif;
}
.window{
  position:absolute;
  width:min(600px,calc(100vw - 16px));
  height:auto;
  min-height:182px;
  background:#ffb8c8;
  border:1px solid #008cff;
  border-radius:9px;
  box-shadow:0 5px 18px rgba(0,0,0,.35);
  overflow:hidden;
}
.titlebar{
  height:31px;
  background:#087dcc;
  color:#fff;
  display:flex;
  align-items:center;
  padding:0 12px;
  font-size:13px;
  user-select:none;
}
.titlebar .icon{margin-right:8px;font-size:14px}
.titlebar .name{flex:1}
.controls{display:flex;gap:22px;font-size:15px;opacity:.95}
.content{
  height:auto;
  min-height:151px;
  text-align:center;
  padding-top:15px;
}
.content h1{
  margin:0;
  font-size:clamp(18px,5vw,23px);
  color:#050505;
}
button{
  margin-top:34px;
  padding:16px 25px;
  border:0;
  background:#fff;
  color:#050505;
  font-size:18px;
  font-weight:700;
  cursor:pointer;
}
button:hover{background:#ff5454;color:#fff}

.popup{
  position:absolute;
  width:248px;
  height:110px;
  background:#ffb8c8;
  border:1px solid #aaa;
  border-radius:6px;
  box-shadow:0 5px 18px rgba(0,0,0,.3);
  opacity:0;
  transform:scale(.98);
  animation:appear .35s ease forwards;
  z-index:20;
}
.popup .bar{
  height:31px;
  background:#f5f5f5;
  color:#777;
  display:flex;
  align-items:center;
  padding:0 10px;
  font-size:12px;
  border-bottom:1px solid #ddd;
}
.popup .bar span:first-child{margin-right:7px;color:#1683c5}
.popup .bar .pname{flex:1}
.popup .msg{
  height:79px;
  display:flex;
  align-items:center;
  padding-left:13px;
  font-size:16px;
  font-weight:700;
  white-space:nowrap;
}
@keyframes appear{
  from{opacity:0;transform:scale(.96)}
  to{opacity:1;transform:scale(1)}
}

@media (max-width:600px){
  .window{width:calc(100vw - 16px);min-height:170px;}
  .titlebar{height:30px;padding:0 9px;font-size:12px;}
  .controls{gap:12px;font-size:14px;}
  .content{min-height:140px;padding:13px 8px 12px;}
  .content h1{font-size:clamp(17px,5.8vw,22px);}
  button{margin-top:25px;padding:13px 16px;font-size:clamp(13px,4.2vw,17px);max-width:100%;}
  .popup{width:min(248px,calc(100vw - 16px));}
  .popup .msg{font-size:clamp(13px,4vw,16px);padding-left:10px;}
}
</style>
</head>
<body>

<div class="window" id="mainWindow">
  <div class="titlebar">
    <span class="icon">🪶</span>
    <span class="name">♡ BÍ MẬT QUỐC GIA ♡</span>
    <div class="controls"><span>−</span><span>□</span><span>×</span></div>
  </div>
  <div class="content">
    <h1>SUỴT ! GIỮ BÍ MẬT NHA !</h1>
    <button id="show">OK BABI !!! SHOW ME !!!</button>
  </div>
</div>

<script>
const main = document.getElementById("mainWindow");
let started = false;
let count = 0;

function centerMain(){
  const w = Math.min(600, innerWidth - 16);
  const h = main.offsetHeight || 182;
  main.style.left = Math.max(8,(innerWidth-w)/2)+"px";
  main.style.top = Math.max(8,(innerHeight-h)/2)+"px";
}
centerMain();
addEventListener("resize",centerMain);

function createPopup(){
  const p=document.createElement("div");
  p.className="popup";

  const popupW=Math.min(248, innerWidth-16);
   const maxX=Math.max(8,innerWidth-popupW-8);
  const maxY=Math.max(8,innerHeight-110-8);

  p.style.left=Math.floor(Math.random()*(maxX+1))+"px";
  p.style.top=Math.floor(Math.random()*(maxY+1))+"px";
  p.style.zIndex=20+count;

  p.innerHTML=`
    <div class="bar">
      <span>🪶</span><span class="pname">Hẹ He</span>
      <span>−　□　×</span>
    </div>
    <div class="msg">Toy Thích Em Lắm Á &gt;&lt; ♥</div>
  `;

  document.body.appendChild(p);
  count++;

  // Giống bản Python: popup mới xuất hiện liên tục
  setTimeout(createPopup,150);
}

document.getElementById("show").addEventListener("click",()=>{
  if(!started){
    started=true;
    createPopup();
  }
});
</script>
</body>
</html>
